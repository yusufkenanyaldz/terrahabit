<?xml version="1.0" encoding="utf-8"?>
<!-- Widget'ta bir alışkanlık, tek satır: simge, sayılar, "+" ve onay.
     Ad yazmıyor (kullanıcı isteği); alışkanlık simgesinden tanınıyor ve beyinden gelen
     yol doğrudan simgenin yanında biter. Güç çubuğu kaldırıldı: sağ sütun dar olduğu için
     zaten 20 dp'lik bir çubuğa sıkışıp yolun devamı gibi görünüyordu; aşama rengini
     simge ve yüzde zaten taşıyor.
     Yükseklik eşit paylaşılır (weight=1): yollar her satırın ortasına bağlanır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/satir_kok"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/satir_ikon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/satir_yuzde"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:shadowColor="#E6000000"
        android:shadowRadius="6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/satir_arti_alan"
        android:layout_width="30dp"
        android:layout_height="28dp">
        <ImageView
            android:id="@+id/satir_arti"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:contentDescription="+1" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/satir_onay_alan"
        android:layout_width="30dp"
        android:layout_height="28dp">
        <ImageView
            android:id="@+id/satir_onay"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:contentDescription="Bugün yaptım" />
    </FrameLayout>
</LinearLayout>
