<?xml version="1.0" encoding="utf-8"?>
<!-- Widget'ta bir alışkanlık satırı: aşama noktası, ad, alt bilgi, onay / +1 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/satir_kok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/satir_metin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/satir_nokta"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:src="@drawable/widget_nokta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/satir_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/satir_alt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/satir_buton_alan"
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/satir_onay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_onay_bos" />

        <TextView
            android:id="@+id/satir_sayac"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_sayac"
            android:gravity="center"
            android:text="+1"
            android:textColor="#7DF4FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
